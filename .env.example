# Copy to .env and fill in real values. Never commit .env.
# Required: SECRET must be >= 32 bytes, e.g. `openssl rand -hex 32`.

SECRET=replace-with-openssl-rand-hex-32

# Public host, including port. Used to build secret links.
HOST=localhost:3000

# true when served over HTTPS (https links, HSTS, and Secure session cookies)
SSL=false

# disabled | simple | full (full is not implemented; it returns 501)
AUTH_MODE=disabled

# Serve the built UI from public/app
UI_ENABLED=true

# Redis / Valkey
# For TLS use rediss:// and for auth put the password here or in REDIS_PASSWORD.
REDIS_URL=redis://127.0.0.1:6379/0
# Required by compose.yaml: authenticates both the server and the web client.
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=replace-with-openssl-rand-hex-24
REDIS_TIMEOUT=5
REDIS_RECONNECT_ATTEMPTS=2

# Comma-separated TTLs in seconds: 30 min, 12 h, 24 h, 3 d
TTL_OPTIONS=1800,43200,86400,259200
DEFAULT_TTL=86400

# Session lifetime (seconds), simple auth mode
SESSION_TTL=1209600

# Rate limits (requests per window per client). Signup and signin share SIGNIN.
RATE_LIMIT_CONCEAL=30
RATE_LIMIT_REVEAL=60
RATE_LIMIT_SIGNIN=10
RATE_LIMIT_WINDOW=60

# Maximum secret payload in bytes (default 1 MiB; boot rejects > 10 MiB)
MAX_SECRET_BYTES=1048576

# Only set this when a reverse proxy/load balancer terminates connections.
# TRUSTED_PROXIES must contain the proxy CIDRs that may supply X-Forwarded-For.
TRUST_PROXY=false
TRUSTED_PROXIES=

# Serve Prometheus metrics at /metrics. Off by default (exposes traffic volume).
METRICS_ENABLED=false

# Puma (WEB_CONCURRENCY=0 runs a single process; 2+ enables cluster mode)
WEB_CONCURRENCY=2
PUMA_MIN_THREADS=1
PUMA_MAX_THREADS=5
LOG_LEVEL=info

# CLI only: non-interactive password for `bin/ots` (otherwise a hidden prompt is used).
# Do not put this in a shell history; prefer the prompt for local use.
# OTS_PASSWORD=
