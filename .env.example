# Copy to .env and fill in real values. Never commit .env.
# Required: SECRET must be >= 32 bytes, e.g. `openssl rand -hex 32`.
# The placeholders below are deliberately invalid: boot refuses them, so a
# copied file cannot run with a key everyone knows.

SECRET=CHANGE-ME

# Public host, including port. Used to build secret links.
HOST=localhost:3000

# true when served over HTTPS (https links, HSTS, and Secure session cookies)
SSL=false

# disabled | simple | full (full is not implemented; it returns 501)
AUTH_MODE=disabled

# Serve the built UI from public/app
UI_ENABLED=true

# Redis / Valkey
# For TLS use rediss:// and for auth put the password here or in REDIS_PASSWORD.
# Compose service DNS is `redis`; use 127.0.0.1 only for a standalone/dev process
# running on the same host as Redis. A copied .env overrides Compose's default,
# so leaving this as 127.0.0.1 makes the web container fail its health check.
REDIS_URL=redis://redis:6379/0
# Required by compose.yaml: authenticates both the server and the web client.
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=CHANGE-ME
REDIS_TIMEOUT=5
REDIS_RECONNECT_ATTEMPTS=2
# Compose only: Redis memory ceiling. Required for the noeviction policy to mean
# anything and for the onetime_redis_memory_used_ratio metric to be exported.
REDIS_MAXMEMORY=256mb

# Comma-separated TTLs in seconds: 30 min, 12 h, 24 h, 3 d
TTL_OPTIONS=1800,43200,86400,259200
DEFAULT_TTL=86400

# Session lifetime (seconds), simple auth mode
SESSION_TTL=1209600

# Rate limits (requests per window per client). Each flow has its own scope so
# a burst in one cannot lock out unrelated routes.
RATE_LIMIT_CONCEAL=30
RATE_LIMIT_REVEAL=60
RATE_LIMIT_SIGNIN=10
RATE_LIMIT_SIGNUP=10
RATE_LIMIT_REQUEST=10
RATE_LIMIT_RESPOND=10
RATE_LIMIT_WEBHOOK=10
RATE_LIMIT_WEBHOOK_READ=10
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_DELETE=3
RATE_LIMIT_BURN=10
RATE_LIMIT_SIGNOUT=10
RATE_LIMIT_METRICS=5
RATE_LIMIT_META=300
RATE_LIMIT_METRICS_AUTH=5
RATE_LIMIT_WINDOW=60
# D-012b: total guesses per secret per window, keyed by the opaque secret id.
# On by default; a wrong passphrase never consumes the record.
RATE_LIMIT_PASSPHRASE=5
RATE_LIMIT_PASSPHRASE_WINDOW=900

# Maximum secret payload in bytes (default 1 MiB; boot rejects > 10 MiB)
MAX_SECRET_BYTES=1048576

# The shipped topology terminates TLS on a proxy on this host (APP_BIND=127.0.0.1).
# Trust only that loopback hop's X-Forwarded-For, otherwise every real user arrives
# as 127.0.0.1 and all per-IP rate limits collapse into one global bucket. Remote
# peers are never trusted: client_id ignores X-Forwarded-For unless REMOTE_ADDR is
# itself in TRUSTED_PROXIES, so binding to 0.0.0.0 cannot enable header spoofing.
TRUST_PROXY=true
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Serve Prometheus metrics at /metrics. Off by default (exposes traffic volume).
# When enabled a token is MANDATORY: generate one (openssl rand -hex 24) and set
# it in the operator's secret store. An empty or short token fails boot with a
# clear error (config.rb); with METRICS_ENABLED=false the endpoint returns 404.
METRICS_ENABLED=false
METRICS_TOKEN=

# Puma (WEB_CONCURRENCY=0 runs a single process; 2+ enables cluster mode)
WEB_CONCURRENCY=2
PUMA_MIN_THREADS=1
PUMA_MAX_THREADS=5
# Seconds a worker may take to boot before Puma stops it.
PUMA_WORKER_TIMEOUT=60
LOG_LEVEL=info

# CLI only: non-interactive password for `bin/ots` (otherwise a hidden prompt is used).
# Do not put this in a shell history; prefer the prompt for local use.
# OTS_PASSWORD=

# Host interface the app port is published on. Use 127.0.0.1 when the TLS
# proxy runs on this host, so port 3000 is not on the internet.
APP_BIND=127.0.0.1
# Host port mapped to the container's port 3000.
APP_PORT=3000
# Fixed subnet for the internal Redis network (T-71 host firewall rule).
REDIS_SUBNET=10.77.13.0/24

# CLI-only overrides (not used by the web process). OTS_URL wins over
# HOST/SSL when set; OTS_ALLOW_INSECURE=1 explicitly permits plaintext HTTP
# to a non-loopback host. Never set either in a production web deployment.
# OTS_URL=
# OTS_ALLOW_INSECURE=
# OTS_SECRET=        # CLI conceal/reveal without a web session
# OTS_PASSPHRASE=    # passphrase used by CLI conceal/reveal
# OTS_NEW_SECRET=    # rotate-key: must be >= 32 bytes and differ from SECRET

# TESTING ONLY: disables the webhook SSRF guard so a local receiver can be
# used. Never enable on a public instance — private/metadata URLs become
# reachable. Leave unset in normal operation.
# WEBHOOK_ALLOW_PRIVATE=

# Vite dev-server API proxy target (frontend development only).
# VITE_API_PROXY=http://127.0.0.1:3100
