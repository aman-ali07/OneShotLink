#!/usr/bin/env ruby
# frozen_string_literal: true

require "io/console"
require "optparse"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
begin
  require "bundler/setup"
rescue LoadError
  # Running from a plain gem install; dependencies are already on the load path.
end
require "onetime"

module Cli
  module_function

  def password_from(name = "Password")
    if ENV["OTS_PASSWORD"]
      return ENV["OTS_PASSWORD"]
    end

    unless $stdin.tty?
      abort "Set OTS_PASSWORD or run this command from an interactive terminal."
    end

    value = IO.console.getpass("#{name}: ")
    if name == "Password"
      again = IO.console.getpass("Confirm password: ")
      abort "Passwords do not match." unless value == again
    end
    value
  end

  def print_customer(customer)
    puts "id: #{customer[:id]}"
    puts "email: #{customer[:email]}"
  end

  def create(email)
    abort "Usage: ots customers create --email EMAIL" if email.to_s.empty?
    password = password_from
    result = Onetime::Logic::SignUp.new(email: email, password: password).call
    Onetime::Models::Session.destroy(result[:session_token])
    puts "Created customer"
    print_customer(result[:customer])
  rescue Onetime::Error => e
    abort "Error (#{e.code}): #{e.message}"
  end

  def reset_password(email)
    abort "Usage: ots customers reset-password --email EMAIL" if email.to_s.empty?
    customer = Onetime::Models::Customer.find_by_email(email)
    abort "No customer with that email." unless customer

    password = password_from("New password")
    bounds = Onetime::Logic::SignUp::MIN_PASSWORD_BYTES..Onetime::Logic::SignUp::MAX_PASSWORD_BYTES
    unless password.is_a?(String) && bounds.cover?(password.bytesize)
      abort "Password must be #{bounds.begin} to #{bounds.end} characters."
    end
    Onetime::Models::Customer.update_password(customer[:id], password)
    # A reset is an administrative credential change: drop every live session.
    Onetime::Models::Session.revoke_all(customer[:id])
    puts "Password updated; all sessions revoked"
    print_customer(customer)
  rescue Onetime::Error => e
    abort "Error (#{e.code}): #{e.message}"
  end

  def list
    # SCAN keeps an admin listing from blocking Redis on a large keyspace.
    ids = Onetime::Store.redis.scan_each(match: "customer:index:*", count: 500).to_a
    if ids.empty?
      puts "No customers."
      return
    end

    puts "id\temail\trole"
    ids.each do |index_key|
      id = Onetime::Store.redis.get(index_key)
      next unless id

      customer = Onetime::Models::Customer.find(id)
      next unless customer

      puts "#{customer[:id]}\t#{customer[:email]}\t#{customer[:role]}"
    end
  end

  def show(email)
    abort "Usage: ots customers show --email EMAIL" if email.to_s.empty?
    customer = Onetime::Models::Customer.find_by_email(email)
    abort "No customer with that email." unless customer

    print_customer(customer)
    puts "role: #{customer[:role]}"
    puts "created_at: #{customer[:created_at]}"
  end

  def set_role(email, role)
    abort "Usage: ots customers set-role --email EMAIL --role customer|admin" if email.to_s.empty?
    unless %w[customer admin].include?(role.to_s)
      abort "Role must be one of: customer, admin"
    end
    customer = Onetime::Models::Customer.find_by_email(email)
    abort "No customer with that email." unless customer

    Onetime::Models::Customer.update_role(customer[:id], role)
    # Privilege changes are security events, even when made from the CLI.
    Onetime::Audit.record("admin.role_changed", actor_id: customer[:id], detail: role)
    puts "Role updated"
    print_customer(customer)
    puts "role: #{role}"
  end

  def audit(limit: 50)
    entries = Onetime::Audit.recent(limit: limit)
    puts JSON.pretty_generate(entries)
  end

  def health
    checks = {}

    checks["config"] = begin
      Onetime::Config.validate!
      "ok"
    rescue Onetime::Config::Error => e
      "fail (#{e.message})"
    end

    checks["redis"] = Onetime::Store.healthy? ? "ok" : "fail (no PONG)"

    checks["secret_keys"] = begin
      count = Onetime::Store.redis.scan_each(
        match: "#{Onetime::Models::Secret::OBJECT_PREFIX}*", count: 500
      ).count
      "#{count} stored"
    rescue StandardError => e
      "fail (#{e.class})"
    end

    checks.each { |name, result| puts "#{name}: #{result}" }
    abort "Health check failed" if checks.values.any? { |v| v.start_with?("fail") }
    puts "Status: ok"
  end

  def migrate(dry_run: false)
    result = dry_run ? Onetime::Migrate.dry_run : Onetime::Migrate.apply!
    # Counts/status only: never the destination path or any stored value.
    Onetime::Audit.record("admin.migrated", actor_id: "cli",
                          detail: "dry_run=#{dry_run} applied=#{result[:applied].length}")

    puts "schema: current=#{result[:current]} target=#{result[:target]}"
    if dry_run
      puts result[:planned].empty? ? "dry-run: nothing to apply" : "dry-run: would apply #{result[:planned].join(', ')}"
    elsif result[:applied].empty?
      puts "migrate: already current; nothing applied"
    else
      puts "migrate: applied #{result[:applied].join(', ')}"
    end
  rescue Onetime::Error => e
    abort "Error (#{e.code}): #{e.message}"
  end

  def work_webhooks(limit)
    claimed = Onetime::Webhook.claim(limit: limit)
    counts = Hash.new(0)
    claimed.each do |item|
      counts[Onetime::Webhook.deliver(item)] += 1
    end
    # Attribution for an off-host/scheduled worker. Counts and status only:
    # no endpoint ids, signing secrets, or payload data in the audit stream.
    Onetime::Audit.record("webhook.worker_run", actor_id: "cli",
                          detail: "claimed=#{claimed.length} delivered=#{counts[:delivered]} " \
                                  "retrying=#{counts[:retrying]} failed=#{counts[:failed]}")
    puts "Webhooks: claimed=#{claimed.length} delivered=#{counts[:delivered]} " \
         "retrying=#{counts[:retrying]} failed=#{counts[:failed]} skipped=#{counts[:skipped]}"
  end

  def rotate_key
    unless ENV["OTS_NEW_SECRET"]
      abort "Set OTS_NEW_SECRET to the new instance secret (>= 32 bytes)."
    end
    if ENV["OTS_NEW_SECRET"].bytesize < 32
      abort "OTS_NEW_SECRET must be at least 32 bytes."
    end
    if ENV["OTS_NEW_SECRET"] == ENV["SECRET"]
      abort "OTS_NEW_SECRET must differ from the current SECRET."
    end

    stats = Onetime::Logic::RotateKey.new(new_secret: ENV["OTS_NEW_SECRET"]).call
    Onetime::Audit.record("admin.key_rotated", actor_id: "cli",
                          detail: "reencrypted=#{stats[:reencrypted]} skipped=#{stats[:skipped]}")
    puts "Re-encrypted #{stats[:reencrypted]} secret(s) with the new key."
    puts "Skipped #{stats[:skipped]} record(s) (unreadable or consumed during rotation)." if stats[:skipped].positive?
    puts "Update SECRET to OTS_NEW_SECRET and restart the web process."
  rescue Onetime::Error => e
    abort "Error (#{e.code}): #{e.message}"
  end

  def backup(path)
    abort "Usage: ots backup --out FILE" if path.to_s.empty?
    stats = Onetime::Backup.export(path)
    # Never record the path: it can identify a customer or a backup location.
    Onetime::Audit.record("admin.backup_exported", actor_id: "cli",
                          detail: "secrets=#{stats[:secrets]} customers=#{stats[:customers]}")
    puts "Wrote #{stats[:secrets]} secret record(s) and #{stats[:customers]} customer(s) to #{path}"
  rescue Onetime::Error => e
    abort "Error (#{e.code}): #{e.message}"
  end

  def restore(path, force: false)
    abort "Usage: ots restore --in FILE" if path.to_s.empty?
    abort "No such file: #{path}" unless File.file?(path)

    stats = Onetime::Backup.restore(path, force: force)
    Onetime::Audit.record("admin.restored", actor_id: "cli",
                          detail: "force=#{force} secrets=#{stats[:secrets]} customers=#{stats[:customers]}")
    puts "Restored #{stats[:secrets]} secret record(s) and #{stats[:customers]} customer(s) from #{path}"
  rescue Onetime::Error => e
    abort "Error (#{e.code}): #{e.message}"
  end

  # Secret material is read from stdin (or OTS_SECRET), never from argv, so it
  # cannot leak through shell history or a process listing. Only the key/link
  # and the revealed value are printed; neither is written to a log.
  def conceal(ttl: 1800)
    secret = if !$stdin.tty?
               $stdin.read
             else
               ENV["OTS_SECRET"]
             end
    abort "Provide the secret on stdin or in OTS_SECRET (never as an argument)." if secret.nil?
    abort "The secret is empty." if secret.empty?

    result = Onetime::CliApi.conceal(secret: secret, ttl: ttl, passphrase: ENV["OTS_PASSPHRASE"])
    puts result[:secret_key]
    puts result[:link]
  rescue Onetime::Error => e
    abort "Error: #{e.message}"
  end

  def reveal(key)
    abort "Usage: ots reveal SECRET_KEY" if key.to_s.empty?

    value = Onetime::CliApi.reveal(key: key, passphrase: ENV["OTS_PASSPHRASE"])
    abort "No secret was returned." if value.nil?

    puts value
  rescue Onetime::Error => e
    abort "Error: #{e.message}"
  end

  def help
    puts <<~TEXT
      Usage: ots COMMAND [options]

      Commands:
        customers create --email EMAIL            Create a customer
        customers reset-password --email EMAIL    Set a new password (revokes sessions)
        customers list                            List customers (id, email, role)
        customers show --email EMAIL              Show one customer
        customers set-role --email EMAIL --role R  Set role (customer|admin)
        conceal [--ttl N]                         Create a secret (content on stdin)
        reveal SECRET_KEY                         Reveal a secret once (content to stdout)
        health                                    Validate config and Redis
        audit [--limit N]                         List recent security events (newest first)
        backup --out FILE                         Export encrypted records to FILE
        restore --in FILE [--force]               Restore records (refuses to overwrite live keys)
        rotate-key                                Re-encrypt all secrets under OTS_NEW_SECRET
        migrate [--dry-run]                       Stamp/advance the Redis schema version (idempotent)
        webhooks:work [LIMIT]                     Deliver queued webhook events (default 10)
        version                                   Print the version

      Password / secret input:
        Set OTS_PASSWORD for automation, or enter it at a hidden prompt.
        Passwords are never accepted as command-line arguments. Secret content
        for `conceal` comes from stdin (or OTS_SECRET); an optional passphrase
        comes from OTS_PASSPHRASE. OTS_URL overrides the API base URL.

      Key rotation:
        OTS_NEW_SECRET=<new secret> ots rotate-key
    TEXT
  end
end

command = ARGV.shift
options = {}
parser = OptionParser.new do |opts|
  opts.on("--email EMAIL", "Customer email") { |value| options[:email] = value }
  opts.on("--role ROLE", "Role (customer|admin)") { |value| options[:role] = value }
  opts.on("--out FILE", "Output file for backup") { |value| options[:out] = value }
  opts.on("--in FILE", "Input file for restore") { |value| options[:in] = value }
  opts.on("--force", "Overwrite existing keys during restore") { options[:force] = true }
  opts.on("--dry-run", "Report planned migrations without writing") { options[:dry_run] = true }
  opts.on("--ttl N", Integer, "Secret lifetime for `conceal` (default 1800)") { |value| options[:ttl] = value }
  opts.on("--limit N", Integer, "Maximum audit entries to print") { |value| options[:limit] = value }
  opts.on("-h", "--help", "Show help") { puts opts; exit }
end
parser.parse!(ARGV)

# The web app fails closed at boot via config.ru, but CLI/worker processes are
# launched separately (cron, CI). Validate the same contract here so a bad
# TRUSTED_PROXIES CIDR or placeholder password cannot silently disable safety.
# `health` is the diagnostic command: it must run far enough to report the
# failing check rather than being blocked by this gate.
unless command.nil? || %w[help version health].include?(command)
  begin
    Onetime::Config.validate!
  rescue Onetime::Config::Error => e
    abort "onetime: invalid configuration: #{e.message}"
  end
end

case command
when "customers"
  action = ARGV.shift
  case action
  when "create" then Cli.create(options[:email])
  when "reset-password" then Cli.reset_password(options[:email])
  when "list" then Cli.list
  when "show" then Cli.show(options[:email])
  when "set-role" then Cli.set_role(options[:email], options[:role])
  else Cli.help
  end
when "conceal"
  Cli.conceal(ttl: options[:ttl] || 1800)
when "reveal"
  Cli.reveal(ARGV.shift)
when "health"
  Cli.health
when "audit"
  Cli.audit(limit: options[:limit] || 50)
when "backup"
  Cli.backup(options[:out])
when "restore"
  Cli.restore(options[:in], force: options[:force])
when "rotate-key"
  Cli.rotate_key
when "migrate"
  Cli.migrate(dry_run: options[:dry_run])
when "webhooks:work"
  Cli.work_webhooks((ARGV.shift || 10).to_i)
when "version"
  puts Onetime::VERSION
else
  Cli.help
end
