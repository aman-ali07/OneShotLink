# OneShotLink — production environment contract for the approved ₹0 free-tier stack
# Render Web Service (Dockerfile) + Upstash Redis Free (rediss://) + GitHub Actions + Cloudflare Pages.
#
# COPY THIS FILE into the Render dashboard as individual environment variables.
# NEVER create a .env in the repository or bake any of these values into an image.
# Every REPLACE_* value must be generated/supplied by the operator; none is a working key.
# This file is intentionally NOT a sourceable shell file: comments and empty values are
# documentation, and the boot gate rejects the placeholders.

# --- Identity and public origin -------------------------------------------------
# >= 32 bytes. Generate with: openssl rand -hex 32
SECRET=REPLACE_WITH_32_BYTE_HEX
# Host:port WITHOUT a scheme. Must equal the Render public hostname exactly.
HOST=REPLACE_WITH_APP.onrender.com
# true => https:// links, HSTS, Secure/HttpOnly/SameSite cookies. Never false in production.
SSL=true
RACK_ENV=production
AUTH_MODE=simple
UI_ENABLED=true

# --- Datastore (Upstash Free) ---------------------------------------------------
# TLS is mandatory. A plain redis:// URL sends the token and ciphertext in cleartext.
# Upstash issues the token in the console; it is supplied via REDIS_PASSWORD, not in the URL.
REDIS_URL=rediss://REPLACE_WITH_UPSTASH_HOST:6379
REDIS_PASSWORD=REPLACE_WITH_UPSTASH_TOKEN
REDIS_TIMEOUT=5
REDIS_RECONNECT_ATTEMPTS=2
# NOTE: REDIS_MAXMEMORY, REDIS_SUBNET, APP_BIND and APP_PORT are Compose-only.
# They do not exist on Render and must not be copied there.

# --- TTLs and payload bounds ----------------------------------------------------
TTL_OPTIONS=1800,43200,86400,259200
DEFAULT_TTL=86400
SESSION_TTL=1209600
MAX_SECRET_BYTES=1048576

# --- Rate limits (per window, per client) --------------------------------------
RATE_LIMIT_WINDOW=60
RATE_LIMIT_CONCEAL=30
RATE_LIMIT_REVEAL=60
RATE_LIMIT_SIGNIN=10
RATE_LIMIT_SIGNUP=10
RATE_LIMIT_REQUEST=10
RATE_LIMIT_RESPOND=10
RATE_LIMIT_WEBHOOK=10
RATE_LIMIT_WEBHOOK_READ=10
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_DELETE=3
RATE_LIMIT_BURN=10
RATE_LIMIT_SIGNOUT=10
RATE_LIMIT_METRICS=5
RATE_LIMIT_METRICS_AUTH=5
RATE_LIMIT_META=300
# D-012b: per-secret passphrase budget, keyed by the opaque id.
RATE_LIMIT_PASSPHRASE=5
RATE_LIMIT_PASSPHRASE_WINDOW=900

# --- Proxy trust ---------------------------------------------------------------
# DECISION FOR THE FIRST BETA: false. Rate limiting then uses the proxy IP as a
# single coarse bucket (safe against XFF spoofing). Set true ONLY after the exact
# Render egress CIDRs are confirmed and the proxy is known to overwrite XFF.
TRUST_PROXY=false
TRUSTED_PROXIES=

# --- Observability -------------------------------------------------------------
# Leave off in the first beta: /metrics exposes traffic volume. If enabled, set a
# >= 32-byte token and block /metrics at the edge. Wrong tokens ARE throttled by
# RATE_LIMIT_METRICS_AUTH (app.rb:676-681); successful scrapes use RATE_LIMIT_METRICS.
METRICS_ENABLED=false
METRICS_TOKEN=
LOG_LEVEL=info

# --- Puma ----------------------------------------------------------------------
# Render Free has 512 MB: one worker. PORT is injected by Render; do not set it.
# PORT=                (platform-injected; never override)
WEB_CONCURRENCY=1
PUMA_MIN_THREADS=1
PUMA_MAX_THREADS=5
PUMA_WORKER_TIMEOUT=60

# --- Explicitly forbidden in production ---------------------------------------
# WEBHOOK_ALLOW_PRIVATE disables the webhook SSRF guard and is NOT boot-validated.
# Leave unset/empty in both the web service and the Actions worker.
# WEBHOOK_ALLOW_PRIVATE=
# CLI-only, never set on the web service:
# OTS_URL=
# OTS_ALLOW_INSECURE=
# Vite dev proxy, frontend development only:
# VITE_API_PROXY=
