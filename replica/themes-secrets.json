{
  "themes": [
    {"id": "trust-hosting", "label": "Trust in a third-party host", "kind": "complaint",
     "patterns": ["\\btrust", "trustworth", "wary", "no reason to believe", "how reliable",
                  "storing all my secrets", "public txt file", "hosted by a third party"]},
    {"id": "encryption", "label": "Encryption strength and client-side/ZK", "kind": "complaint",
     "patterns": ["\\bencrypt", "e2e", "end.to.end", "zero.knowledge", "\\bKDF\\b", "entropy",
                  "\\burandom", "client.side", "\\bHKDF", "cryptograph"]},
    {"id": "files", "label": "No file or image secrets", "kind": "complaint",
     "patterns": ["\\bimages?\\b", "\\bfiles?\\b", "attach", "upload"]},
    {"id": "view-limits", "label": "No read-count or view limits", "kind": "complaint",
     "patterns": ["view limits", "greater than 1", "read.count", "viewed .* times"]},
    {"id": "link-scanners", "label": "Link previewers/scanners burn one-time links", "kind": "complaint",
     "patterns": ["scanner", "automated system", "search results", "crawler", "prefetch",
                  "malware scanning", "link preview", "invalidated"]},
    {"id": "availability", "label": "Downtime and DDoS", "kind": "complaint",
     "patterns": ["\\bddos", "downtime", "denial.of.ser", "\\boutage", "went away", "shut down"]},
    {"id": "ux", "label": "Interface and UX", "kind": "complaint",
     "patterns": ["\\bUX\\b", "\\bUI\\b", "\\bI/?standpoint", "interface", "confus", "is the .* a joke",
                  "underwhelming", "clean, intuitive"]},
    {"id": "self-host", "label": "Self-hosting friction", "kind": "complaint",
     "patterns": ["self.host", "host yourself", "deploy", "installed the app", "\\bREADME\\b",
                  "bundle exec", "open source"]},
    {"id": "accounts", "label": "Accounts, signup and recipients", "kind": "complaint",
     "patterns": ["setup an account", "need(ing)? an account", "log ?in", "sign.?up", "registration"]},
    {"id": "pricing", "label": "Price and plans", "kind": "complaint",
     "patterns": ["\\bpricing\\b", "\\bexpensive\\b", "\\bpaid\\b", "\\bfree\\b", "\\bpremium\\b"]}
  ],
  "request_patterns": [
    "would be (nice|great|useful)", "\\bwish\\b", "should (support|allow|have)",
    "\\bmissing\\b", "any way to", "does not support", "don.t support", "\\bwanted something\\b",
    "i wanted", "need to be able"
  ]
}
